# SPDX-License-Identifier: AGPL-3.0-or-later
#
# IRon Table settings. Copy this file to .env and change the values marked CHANGE.
# Never commit .env. It contains secrets.

# --- Application -------------------------------------------------------------
APP_NAME="IRon Table"
APP_ENV=production
# CHANGE: make a key with the command in docs/development.md, section 4, step 5.
APP_KEY=
APP_DEBUG=false
# CHANGE: the address that people type in the browser.
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
# Password hash cost. Higher is slower and stronger.
BCRYPT_ROUNDS=12

# --- First administrator -----------------------------------------------------
# Created on the first start, only when no user exists. scripts/setup.sh sets
# these values. After the first login, remove INITIAL_ADMIN_PASSWORD from .env.
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Network (compose.yaml) --------------------------------------------------
# 127.0.0.1 = reachable from this host only. Use 0.0.0.0 behind a firewall or proxy.
APP_BIND=127.0.0.1
APP_PORT=8080
# Run database migrations when the app container starts.
RUN_MIGRATIONS=true

# --- Logging -----------------------------------------------------------------
# Containers log to stderr. Read logs with: docker compose logs -f
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (service "db") -------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=iron_table
DB_USERNAME=iron_table
# CHANGE: a long random password.
DB_PASSWORD=

# --- Sessions, cache, queue --------------------------------------------------
# "database" needs no extra service. Use "redis" with: --profile redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# Uploaded files stay private on the "storage" volume (spec SEC-04).
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Live updates (service "reverb") -----------------------------------------
BROADCAST_CONNECTION=reverb
# CHANGE: random values. ID: any number. KEY and SECRET: long random strings.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# How the app container sends events to Reverb (inside the Docker network).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Browsers connect to Reverb through APP_URL (path /app/*). The page gives the
# browser the key at run time, so no VITE_REVERB_* settings are needed.
VITE_APP_NAME="${APP_NAME}"

# --- Mail --------------------------------------------------------------------
# "log" writes mail to the log. Set SMTP values to send real mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="iron-table@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI (optional, off by default - spec section 9) ---------------------------
AI_ENABLED=false
# Provider: ollama | openai_compatible | anthropic
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_API_KEY=
AI_MODEL=
