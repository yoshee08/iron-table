# IRon Table web server (FrankenPHP / Caddy). Used by the "app" role.
#
# One public port for everything:
#   /app/*   WebSocket traffic for live updates, forwarded to the "reverb" service
#   other    the Laravel application (PHP)
#
# TLS is not set here. Put a reverse proxy in front for HTTPS.

{
	admin off
	auto_https off
	skip_install_trust

	frankenphp
}

:{$APP_INTERNAL_PORT:8080} {
	# Security headers (backlog B2). The page loads scripts, styles and data only
	# from this server: no inline scripts, no frames, no other sites.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Reverb (Pusher protocol) clients connect to /app/{app-key}.
	# Do not use the URL prefix /app for Laravel routes.
	handle /app/* {
		reverse_proxy {$REVERB_UPSTREAM:reverb:8080}
	}

	handle {
		root * /app/public
		encode zstd br gzip
		php_server
	}
}
